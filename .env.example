# Environment Configuration
# Copy this file to .env and update with your settings
# DO NOT commit .env to version control!

# Application Settings
APP_ENV=development
APP_DEBUG=true
BASE_URL=http://localhost/pickupdrug/

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=pickupdrug

# Session Configuration
SESSION_LIFETIME=1800

# Security
CSRF_ENABLED=true

# ===================
# API CONFIGURATIONS
# ===================

# Google Gemini AI (Chatbot)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Email Configuration (Gmail)
# For Gmail: Use App Password (not regular password)
# Enable 2FA, then create App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME=PickupDrug

# SMS Gateway Configuration
# Option 1: HttpSMS (Self-hosted)
SMS_GATEWAY_TYPE=httpsms
HTTPSMS_API_URL=https://api.httpsms.com
HTTPSMS_USERNAME=your_username
HTTPSMS_PASSWORD=your_password

# Option 2: Semaphore SMS (Commercial - Philippines)
# Get API key from: https://semaphore.co/
# SEMAPHORE_API_KEY=your_semaphore_api_key
# SEMAPHORE_SENDER_NAME=PickupDrug

# Option 3: Twilio (Global)
# Get credentials from: https://www.twilio.com/console
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Facebook Messenger Webhook (Optional)
# Get from: https://developers.facebook.com/
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=
